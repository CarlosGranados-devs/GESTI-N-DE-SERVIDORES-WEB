{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Configuración del Entorno y Node.js */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],

    /* Opciones Recomendadas y Compilación */
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    /* Archivos de Salida */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  }
}